Narrow typst requirement-marker extraction to #r/#req only, and make
`tracey query validate` exit nonzero when a config error left the daemon
with an empty spec set (previously: printed a banner but exited 0).

The upstream extract_req used a denylist of typst stdlib names, so any
third-party `#fn("string")` call (e.g. unify's `#qty("5","s")`) was
treated as a requirement definition. Duplicate "5" markers then fail
config validation, the daemon falls back to an empty config, and
`validate` reports "No spec/impl combinations configured." with exit 0.
--- a/crates/tracey-core/src/spec/typst.rs
+++ b/crates/tracey-core/src/spec/typst.rs
@@ -292,10 +292,10 @@ fn extract_req(code: Node<'_>, bytes: &[u8]) -> Option<ReqDefinition> {
         return None;
     }
     let prefix = slice(bytes, ident.start_byte(), ident.end_byte());
-    // Reject typst stdlib globals so `#image(..)`, `#link(..)`, etc. are never
-    // mistaken for requirement markers. Any other ident is a candidate; if a
-    // spec genuinely mixes prefixes the inference step reports it.
-    if TYPST_BUILTINS.binary_search(&prefix).is_ok() {
+    // Only `#r(...)` and `#req(...)` are requirement markers. A denylist of
+    // typst builtins is insufficient: third-party packages (unify's `#qty`,
+    // etc.) define their own functions that take string args.
+    if !matches!(prefix, "r" | "req") {
         return None;
     }

