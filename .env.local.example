# Per-user env loaded by direnv (see .envrc) and `cargo xtask`
# (via the RIO_-prefixed env layer). Copy to .env.local and edit. Gitignored.
AWS_PROFILE=beme_sandbox

# k8s provider for `cargo xtask k8s ...`. If set, you can omit -p.
# Valid: k3s (local+Rook), eks (AWS).
RIO_K8S_PROVIDER=k3s

# Per-user EKS cluster name. The S3 backend uses tofu workspaces
# for isolation, but cluster_name is a plain var that defaults to
# "rio-build" — the shared default-workspace cluster. Set this to
# rio-<you> when working in a personal workspace, or `tofu apply`
# will try to rename (= destroy + recreate) the cluster and collide
# with rio-build's account-global IAM role/policy names.
# TF_VAR_cluster_name=rio-yourname
#
# Also select a matching tofu workspace ONCE (not via TF_WORKSPACE
# in .env.local — that env var would also leak into the bootstrap
# state, which is account-global and must stay in `default`):
#   tofu -chdir=infra/eks workspace new yourname
# It persists in infra/eks/.terraform/environment.

# State bucket — defaults to rio-tfstate-${account_id} (computed
# from `aws sts get-caller-identity`). Override if you used a
# custom name or the pattern doesn't hold for your account.
# RIO_TFSTATE_BUCKET=my-custom-tfstate-bucket

# State bucket region — defaults to us-east-2.
# RIO_TFSTATE_REGION=us-east-2

# SSH public key for gateway authorized_keys. Used by both
# `cargo xtask k8s up -p k3s` (local k3s) and `cargo xtask k8s deploy -p eks`.
# The key's comment is STRIPPED → single-tenant mode (builds work
# with zero tenant setup). Default: ~/.ssh/id_ed25519.pub
# RIO_SSH_PUBKEY=~/.ssh/id_ed25519.pub

# If set, use this as the authorized_keys comment instead of stripping.
# The gateway maps comment → tenant_name; the scheduler requires that
# tenant to exist. Create it first:
#   kubectl -n rio-system exec deploy/rio-scheduler -- rio-cli create-tenant <name>
# RIO_SSH_TENANT=my-team

# kache (cross-worktree cargo build cache) knobs. These three are the
# supported per-user overrides — the devshell shellHook also loads them
# from this file for non-direnv `nix develop` entries, so keep them as
# single-line VAR=value entries with PLAIN values (no quotes, spaces,
# or escapes: direnv and xtask's dotenvy would strip quotes, a raw
# shell export would keep them, so the loader rejects anything outside
# [A-Za-z0-9_/.+-] with a warning rather than let readers disagree).

# Disable caching. Value-based: 1 or true disables. Toggling is free —
# verified: current cargo does not fingerprint the wrapper, and the
# wrapper stays in place regardless, so no rebuilds either way.
# Caveat: if a disabled rebuild fails with "output file … is not
# writeable", that file is a kache restore (a read-only hardlink whose
# inode is SHARED with the store) — delete it or `cargo clean -p
# <crate>`; never chmod it writable, or rustc would truncate the store
# blob in place and poison future restores.
# KACHE_DISABLED=1

# Override the store eviction cap. The devshell config pins 256GiB
# (kache's own default would be 50GiB). Rio-namespaced like the store
# knob: KACHE_MAX_SIZE is kache's own variable, so a machine-global
# export from another kache-using project must not shrink OUR eviction
# budget — the wrapper ignores it and honors only this one. Accepted
# shape: <integer> immediately followed by KiB|MiB|GiB|TiB (anything
# else is ignored with a wrapper warning).
# Eviction runs in the kache daemon, which snapshots config at spawn —
# run `kache daemon stop` once after changing this (it auto-respawns).
# RIO_KACHE_MAX_SIZE=512GiB

# Relocate the store (default: ~/.cache/rio-build/kache/<env-salt>).
# Useful if your home cache lives on a different filesystem than your
# worktrees — same-FS enables reflink/hardlink restores instead of
# copies. Rio-namespaced on purpose: the wrapper deliberately ignores
# kache's own KACHE_CACHE_DIR so a machine-global export from another
# kache-using project can never repoint this repo's store. Notes:
# overriding bypasses the env-salt epoch (after a toolchain bump,
# prefer wiping it over debugging stale-binary ENOENTs) and the
# 14-day epoch pruning (the relocated store is yours to manage).
# RIO_KACHE_CACHE_DIR=/fast-disk/rio-kache
