{
  "members": [
    {
      "name": "rio-auth",
      "description": "Tenant JWT + assignment HMAC token sign/verify and the gRPC interceptor that wires them"
    },
    {
      "name": "rio-cli",
      "description": "Admin CLI for rio-build — talks to the scheduler's AdminService"
    },
    {
      "name": "rio-common",
      "description": "Shared configuration, observability, and error types for rio-build"
    },
    {
      "name": "rio-controller",
      "description": "Kubernetes operator for rio-build: Pool, ComponentScaler CRDs"
    },
    {
      "name": "rio-gateway",
      "description": "SSH gateway and Nix protocol frontend for rio-build"
    },
    {
      "name": "rio-lease",
      "description": "Kubernetes Lease-based leader election for rio-build components"
    },
    {
      "name": "rio-migrations",
      "description": "Database migration SQL, embedded migrator, and per-migration commentary"
    },
    {
      "name": "rio-nix",
      "description": "Nix protocol types and wire format"
    },
    {
      "name": "rio-proto",
      "description": "Protobuf/gRPC service definitions for rio-build"
    },
    {
      "name": "rio-replay",
      "description": "build-replay campaign engine — evaluation recorder and campaign runner"
    },
    {
      "name": "rio-scheduler",
      "description": "DAG-aware build scheduler for rio-build"
    },
    {
      "name": "rio-store",
      "description": "NAR content-addressable store for rio-build"
    },
    {
      "name": "rio-test-support",
      "description": "Test harness: ephemeral PostgreSQL, wire protocol helpers, mock gRPC services"
    },
    {
      "name": "rio-builder",
      "description": "Build executor with FUSE store for rio-build"
    },
    {
      "name": "rio-crds",
      "description": "CustomResourceDefinition types for rio-build (Pool, ComponentScaler)"
    },
    {
      "name": "xtask",
      "description": "Dev/ops tooling: codegen, local cluster lifecycle, AMI build, helm/k8s helpers"
    }
