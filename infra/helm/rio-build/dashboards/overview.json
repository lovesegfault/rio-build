{
  "uid": "rio-overview",
  "title": "rio-build: Overview",
  "tags": [
    "rio-build",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "rio-build dashboards",
      "tags": [
        "rio-build"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active builds",
      "description": "rio_scheduler_builds_active — builds with at least one non-terminal derivation.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "rio_scheduler_builds_active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "links": [
        {
          "title": "Detail →",
          "url": "/d/rio-build-progress",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Derivations in flight",
      "description": "queued + running. Throughput numerator; sustained high with low running = dispatch stall. NOTE (substitution-replacement Phase B): derivations whose materialization job is pending/parked sit in the SUBSTITUTING bucket, which is excluded from queued — they are visible on the dispatch-flow dashboard's materialization panels and via rio-cli status (substituting_derivations), not here.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "rio_scheduler_derivations_queued + rio_scheduler_derivations_running",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "links": [
        {
          "title": "Detail →",
          "url": "/d/rio-dispatch-flow",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Open attempts",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "rio_scheduler_open_attempts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "links": [
        {
          "title": "Detail →",
          "url": "/d/rio-builder-lifecycle",
          "targetBlank": false
        }
      ],
      "rioMetric": "rio_scheduler_open_attempts",
      "rioNote": "Zero with queued > 0 = no pull-mode capacity claiming work.",
      "description": "Open pull-mode BUILD attempts (active assignment + execution pair minted by PullAssignment, no terminal classification yet) — one attempt per builder pod. The busy-fleet gauge (successor of the retired stream-era workers_active). Store materialization claims are counted by rio_scheduler_open_materialization_attempts instead (A2.4). — Zero with queued > 0 = no pull-mode capacity claiming work."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Actor mailbox",
      "description": "rio_scheduler_actor_mailbox_depth — actor mpsc backlog. Yellow ≥64, red ≥256 = head-of-line blocking.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "rio_scheduler_actor_mailbox_depth",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 64
              },
              {
                "color": "red",
                "value": 256
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "links": [
        {
          "title": "Detail →",
          "url": "/d/rio-scheduler-actor",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "PG pool util (max)",
      "description": "max(rio_store_pg_pool_utilization) across store replicas. Yellow ≥0.7, red ≥0.9 = pool-starved, RPCs queue.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max(rio_store_pg_pool_utilization)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "links": [
        {
          "title": "Detail →",
          "url": "/d/rio-store",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue / running / open attempts",
      "description": "The dispatch-stall test: queued > open attempts with running < open attempts means capacity exists but pulls are not landing — check pool health and spawn intents.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "rio_scheduler_derivations_queued",
          "legendFormat": "queued",
          "refId": "A"
        },
        {
          "expr": "rio_scheduler_derivations_running",
          "legendFormat": "running",
          "refId": "B"
        },
        {
          "expr": "rio_scheduler_open_attempts",
          "legendFormat": "open attempts",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "workers"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Detail →",
          "url": "/d/rio-dispatch-flow",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Store: PutPath p99 / retries",
      "description": "PutPath p99 latency (left) + retries/s (right axis). p99 spikes track S3/PG pressure; retries > 1/s = serialization contention.",
      "gridPos": {
        "x": 14,
        "y": 11,
        "w": 10,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rio_store_put_path_duration_seconds_bucket[5m])))",
          "legendFormat": "putpath p99",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rio_store_putpath_retries_total[5m]))",
          "legendFormat": "retries/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "retries/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "links": [
        {
          "title": "Detail →",
          "url": "/d/rio-store",
          "targetBlank": false
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Build outcomes",
      "description": "rate(rio_scheduler_builds_total[5m]) by outcome. Red (failure) > 0 sustained is the headline alert.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(rio_scheduler_builds_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 20,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "Detail →",
          "url": "/d/rio-build-progress",
          "targetBlank": false
        }
      ]
    }
  ]
}
