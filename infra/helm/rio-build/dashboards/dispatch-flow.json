{
  "uid": "rio-dispatch-flow",
  "title": "rio-build: Dispatch Flow",
  "tags": [
    "rio-build",
    "scheduler"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue / running / open attempts",
      "description": "Derivations queued vs running, overlaid with active open attempts. Queued > open attempts with running < open attempts = dispatch stall.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "rio_scheduler_derivations_queued",
          "legendFormat": "queued",
          "refId": "A"
        },
        {
          "expr": "rio_scheduler_derivations_running",
          "legendFormat": "running",
          "refId": "B"
        },
        {
          "expr": "rio_scheduler_open_attempts",
          "legendFormat": "open attempts",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "open attempts"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queued derivations",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "rio_scheduler_derivations_queued",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 20,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "rioMetric": "rio_scheduler_derivations_queued",
      "rioNote": "The per-kind queue_depth split retired with the placement layer; per-system backlog is queued_by_system on ClusterStatus/GetSpawnIntents.",
      "description": "Ready derivations waiting for a worker (DAG-status count; the per-system split is queued_by_system on ClusterStatus/GetSpawnIntents) — The per-kind queue_depth split retired with the placement layer; per-system backlog is queued_by_system on ClusterStatus/GetSpawnIntents."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Materialization job lifecycle",
      "description": "Substitution-replacement (Phase B): jobs created (by origin) vs claims delivered to store replicas vs terminal resolutions (by outcome). created >> claimed = store executors not keeping up or partitioned from the leader; claimed >> resolved = executions failing or reports not landing; a rising unobtainable/from_source share = upstream losing paths.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(rio_scheduler_materialization_jobs_created_total[5m]))",
          "legendFormat": "created",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rio_scheduler_materialization_claims_total[5m]))",
          "legendFormat": "claimed",
          "refId": "B"
        },
        {
          "expr": "sum by (outcome) (rate(rio_scheduler_materialization_jobs_resolved_total[5m]))",
          "legendFormat": "resolved: {{outcome}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Materialization: stalled (parked) jobs + store executions",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max(rio_scheduler_materialization_stalled)",
          "legendFormat": "stalled (parked)",
          "refId": "A"
        },
        {
          "expr": "sum by (outcome) (rate(rio_store_materialization_executions_total[5m]))",
          "legendFormat": "exec: {{outcome}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "stalled (parked)"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 40
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "rioMetric": "rio_scheduler_materialization_stalled",
      "rioNote": "Action: check the conversion-strictness knobs (conversion_requires_worker_charge / conversion_min_park_dwell_secs) and upstream cache health before cancelling builds.",
      "description": "Parked materialization jobs (park budget exhausted — worker-charged infra failures or establishment charges; waiting on upstream recovery or park-backoff expiry). Leader-published every housekeeping tick from ground truth. The PD-20 re-evaluation converts parked jobs with buildable dependency closures from-source ONLY when the conversion-strictness knobs admit it (conversion_requires_worker_charge: establishment-only-parked jobs never convert while ON; conversion_min_park_dwell_secs: minimum dwell since the most recent park). A sustained nonzero value therefore means either a dead/misconfigured upstream stalling work with no from-source fallback, OR convertible work the knobs are deliberately holding — check the strictness knobs before cancelling builds. — Action: check the conversion-strictness knobs (conversion_requires_worker_charge / conversion_min_park_dwell_secs) and upstream cache health before cancelling builds."
    }
  ]
}
