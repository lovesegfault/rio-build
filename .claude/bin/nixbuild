#!/usr/bin/env bash
# Quiet nix build/check wrapper with a structured log lifecycle. Keeps build
# output out of agent context — full log goes to /tmp/rio-dev/, stdout gets a
# short text report, and the process exits with the underlying nix exit code.
# See .claude/skills/nixbuild/.
#
#   nixbuild [--quick]          edit-loop slice: every check that compiles,
#                               lints, or renders; nothing that executes tests
#   nixbuild --checks           full CI gate via nix-fast-build
#   nixbuild <flake-target>     single attr (leaves ./result like nix build),
#                               e.g. .#checks.x86_64-linux.vm-lifecycle-core-k3s
set -uo pipefail

usage="usage: nixbuild [--quick|--checks|<flake-target>] [extra nix args...]"
target="${1:---quick}"
[[ $# -gt 0 ]] && shift
case "$target" in
  -h | --help) echo "$usage"; exit 0 ;;
  --quick | --checks) ;;
  -*) echo "$usage" >&2; exit 1 ;;
esac

root="$(git rev-parse --show-toplevel)"
branch="$(git -C "$root" rev-parse --abbrev-ref HEAD | tr '/' '-')"
logdir="/tmp/rio-dev"
mkdir -p "$logdir"
iter=0
for f in "$logdir"/rio-"${branch}"-*.log; do
  [[ -e "$f" ]] || break
  n="${f##*-}"; n="${n%.log}"
  [[ "$n" =~ ^[0-9]+$ ]] && ((n > iter)) && iter=$n
done
log="${logdir}/rio-${branch}-$((iter + 1)).log"
: >"$log"

echo "nixbuild: log → $log" >&2
out=""
ntargets=""
case "$target" in
  --quick)
    mode="quick"
    system="$(nix eval --raw --impure --expr builtins.currentSystem)"
    # Test-execution checks are excluded; everything else (clippy, docs,
    # drift/policy, renders) goes to nix, whose per-crate caching decides
    # what actually rebuilds. Keep this filter in sync with the skill doc.
    exclude='^(vm-|nextest-|fuzz-|golden-|mutants-)|^cov-smoke$'
    names=$(nix eval --raw "${root}#checks.${system}" \
      --apply 'cs: builtins.concatStringsSep "\n" (builtins.attrNames cs)' 2>>"$log")
    rc=$?
    if [[ $rc -eq 0 ]]; then
      mapfile -t targets < <(grep -Ev "$exclude" <<<"$names" | sed "s|^|${root}#checks.${system}.|")
      ntargets="${#targets[@]}"
      if [[ $ntargets -eq 0 ]]; then
        echo "nixbuild: quick filter selected zero targets" >>"$log"
        rc=1
      else
        nix build --no-link --keep-going "${targets[@]}" "$@" >>"$log" 2>&1
        rc=$?
      fi
    fi
    ;;
  --checks)
    mode="checks"
    system="$(nix eval --raw --impure --expr builtins.currentSystem)"
    # Cap eval workers — nix-eval-jobs scales badly past ~16 even with more cores.
    nproc_val=$(nproc)
    eval_workers=$(( nproc_val < 16 ? nproc_val : 16 ))
    # CI gate: stream-eval all checks via nix-eval-jobs. --fail-fast (1.6.0+)
    # stops on the first failed build/eval instead of grinding through the
    # rest of the matrix — the gate is binary, so one red drv is enough.
    nix-fast-build --no-nom --skip-cached --fail-fast \
      --eval-workers "$eval_workers" \
      --flake "${root}#checks.${system}" \
      "$@" >>"$log" 2>&1
    rc=$?
    ;;
  *)
    mode="build"
    out=$(nix build -L --out-link "${root}/result" --print-out-paths "${root}#${target#*#}" "$@" 2>>"$log")
    rc=$?
    ;;
esac
store_path="${out%%$'\n'*}"

status="OK"
[[ $rc -ne 0 ]] && status="FAILED"
if [[ "$mode" == "build" ]]; then
  echo "nixbuild ${mode} ${target}: ${status} (exit ${rc})"
else
  echo "nixbuild ${mode}: ${status} (exit ${rc})"
fi
[[ -n "$store_path" ]] && echo "out: ${store_path}  (./result)"
[[ -n "$ntargets" ]] && echo "targets: ${ntargets}"
echo "log: ${log} ($(stat -c %s "$log") bytes)"

if [[ $rc -ne 0 ]]; then
  mapfile -t drv_failed < <(grep -oP "(Cannot build|builder for|build of) '\K/nix/store/[^']+\.drv" "$log" | sort -u)
  if [[ ${#drv_failed[@]} -gt 0 ]]; then
    echo "failed derivations:"
    printf '  %s\n' "${drv_failed[@]}"
  fi
  echo
  echo "--- last 80 lines of ${log} ---"
  tail -n 80 "$log"
fi

exit "$rc"
