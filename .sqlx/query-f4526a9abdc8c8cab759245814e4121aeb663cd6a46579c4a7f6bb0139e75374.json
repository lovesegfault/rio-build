  "query": "\n        SELECT a.exec_id, a.builder_id\n        FROM assignments a\n        JOIN derivations d USING (derivation_id)\n        WHERE d.drv_hash = $1\n        ORDER BY a.assigned_at DESC, a.exec_id DESC NULLS LAST\n        LIMIT 1\n        ",
